#!/usr/bin/env python3
"""termchat: talk to Gemini, Copilot and DeepSeek from a terminal.

No vendor API is used. The CLI starts a local HTTP bridge (loopback by
default); the companion browser extension polls that bridge from an open chat
tab, types the prompt into the page, scrapes the streamed answer and posts it
back. You stay signed in in your normal browser profile.
"""

from __future__ import annotations

import argparse
import hmac
import ipaddress
import json
import os
import re
import shutil
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid
from dataclasses import dataclass, field
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

APP = "termchat"
VERSION = "0.1.0"
SITES = ("gemini", "copilot", "deepseek")
SITE_ORIGINS = {
    "gemini": "https://gemini.google.com",
    "copilot": "https://copilot.microsoft.com",
    "deepseek": "https://chat.deepseek.com",
}
ALLOWED_ORIGINS = frozenset(SITE_ORIGINS.values())
DEFAULT_BASE_PORT = 8765
DEFAULT_PORT_SPAN = 10
DEFAULT_TIMEOUT = 300.0
DEFAULT_CONNECT_WAIT = 30.0
MAX_BODY = 16 * 1024 * 1024
LARGE_PROMPT = 100_000


# --------------------------------------------------------------------------
# state shared with the HTTP handlers
# --------------------------------------------------------------------------


@dataclass
class Job:
    site: str
    prompt: str
    new_chat: bool
    inspect: bool
    timeout: float
    id: str = field(default_factory=lambda: uuid.uuid4().hex)
    text: str = ""
    markdown: str | None = None
    error: str | None = None
    meta: dict | None = None
    state: str = "pending"  # pending | running | done
    assigned: bool = False
    assigned_at: float = 0.0
    seq: int = 0
    finished_at: float = 0.0
    last_seen: float = 0.0


class Bridge:
    """Job queue plus the condition variable the CLI waits on."""

    def __init__(
        self,
        verbose: bool = False,
        token: str = "",
        mode: str = "ephemeral",
        pending_ttl: float = 15.0,
    ) -> None:
        self.verbose = verbose
        self.token = token
        self.mode = mode
        self.pending_ttl = pending_ttl
        self.cond = threading.Condition()
        self.pending: list[Job] = []
        self.active: dict[str, Job] = {}
        self.jobs: dict[str, Job] = {}
        self.pings = 0
        self.last_ping = 0.0
        self.polls: set[str] = set()

    def submit(self, job: Job) -> None:
        with self.cond:
            job.last_seen = time.monotonic()
            self.jobs[job.id] = job
            self.pending.append(job)
            self._prune()
            self.cond.notify_all()

    def _prune(self) -> None:
        """Drop abandoned and old finished jobs. Caller holds the condition."""
        now = time.monotonic()
        for job_id, job in list(self.jobs.items()):
            if (
                job.state == "pending"
                and self.mode == "server"
                and now - job.last_seen > self.pending_ttl
            ):
                self.pending = [pending for pending in self.pending if pending.id != job_id]
                self.jobs.pop(job_id, None)
            elif job.state == "done" and now - job.finished_at > 3600:
                self.jobs.pop(job_id, None)
        extra = len(self.jobs) - 500
        if extra > 0:
            done = sorted(
                (job.finished_at, job_id)
                for job_id, job in self.jobs.items()
                if job.state == "done"
            )
            for _, job_id in done[:extra]:
                self.jobs.pop(job_id, None)

    def take(self, site: str, wait: float) -> Job | None:
        deadline = time.monotonic() + max(0.0, wait)
        with self.cond:
            self._prune()
            while True:
                for job in list(self.pending):
                    if job.site == site:
                        self.pending = [
                            pending for pending in self.pending if pending.id != job.id
                        ]
                        job.assigned = True
                        job.state = "running"
                        job.assigned_at = time.monotonic()
                        job.seq += 1
                        self.active[job.id] = job
                        self.cond.notify_all()
                        return job
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return None
                self.cond.wait(remaining)
                self._prune()

    def update(
        self,
        job_id: str,
        text: str | None = None,
        error: str | None = None,
        meta: dict | None = None,
        state: str | None = None,
        markdown: str | None = None,
    ) -> bool:
        with self.cond:
            job = self.active.get(job_id)
            if job is None:
                return False
            if text is not None:
                job.text = text
            if markdown is not None:
                job.markdown = markdown
            if error is not None:
                job.error = error
            if meta is not None:
                job.meta = meta
            if state is not None:
                job.state = state
            job.seq += 1
            if state == "done":
                job.finished_at = time.monotonic()
                self.active.pop(job_id, None)
            self.cond.notify_all()
            return True

    def snapshot(self, job_id: str, after: int = -1, wait: float = 0.0) -> dict | None:
        """Current job state; long-polls until seq > after, done, or timeout."""
        deadline = time.monotonic() + max(0.0, wait)
        with self.cond:
            job = self.jobs.get(job_id)
            if job is None:
                return None
            # Any state poll is a heartbeat: a live client keeps its queued job.
            job.last_seen = time.monotonic()
            self._prune()
            while job.seq <= after and job.state != "done":
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    break
                self.cond.wait(remaining)
                job.last_seen = time.monotonic()
            return self._snapshot(job)

    def _snapshot(self, job: Job) -> dict:
        ahead = 0
        now = time.monotonic()
        if job.state == "pending":
            for other in self.pending:
                if other.id == job.id:
                    break
                if other.site == job.site and (
                    self.mode != "server"
                    or now - other.last_seen <= self.pending_ttl
                ):
                    ahead += 1
        return {
            "id": job.id,
            "site": job.site,
            "state": job.state,
            "text": job.text,
            "markdown": job.markdown,
            "error": job.error,
            "meta": job.meta,
            "inspect": job.inspect,
            "seq": job.seq,
            "queued_ahead": ahead,
        }

    def cancel(self, job_id: str) -> bool:
        with self.cond:
            job = self.jobs.get(job_id)
            if job is None or job.state == "done":
                return False
            self.pending = [pending for pending in self.pending if pending.id != job_id]
            self.active.pop(job_id, None)
            job.state = "done"
            job.error = "canceled by client"
            job.seq += 1
            job.finished_at = time.monotonic()
            self.cond.notify_all()
            return True


# --------------------------------------------------------------------------
# HTTP bridge
# --------------------------------------------------------------------------


def origin_allowed(origin: str) -> bool:
    if origin in ALLOWED_ORIGINS:
        return True
    return origin.startswith(("chrome-extension://", "moz-extension://"))


def is_loopback_address(bind: str) -> bool:
    if bind == "localhost":
        return True
    try:
        return ipaddress.ip_address(bind).is_loopback
    except ValueError:
        return False


class BridgeHandler(BaseHTTPRequestHandler):
    bridge: Bridge  # set by start_bridge() before serving
    server_version = f"{APP}/{VERSION}"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt: str, *args: object) -> None:
        if self.bridge.verbose:
            sys.stderr.write("[bridge] " + (fmt % args) + "\n")

    # -- helpers ---------------------------------------------------------

    def _send(self, status: int, payload: dict | None = None, origin: str = "") -> None:
        body = b"" if payload is None else json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        if origin:
            self.send_header("Access-Control-Allow-Origin", origin)
            self.send_header("Vary", "Origin")
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            if body:
                self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _origin(self) -> str | None:
        """Return the allowed Origin ('' when absent), or None after a 403."""
        origin = self.headers.get("Origin") or ""
        if origin and not origin_allowed(origin):
            self._send(403, {"error": "origin not allowed"})
            return None
        return origin

    def _authorized(self, origin: str = "") -> bool:
        """When a token is configured, require it on job traffic."""
        token = self.bridge.token
        if not token:
            return True
        supplied = self.headers.get("X-Termchat-Token") or ""
        if hmac.compare_digest(supplied.encode("utf-8"), token.encode("utf-8")):
            return True
        self._send(401, {"error": "missing or invalid token"}, origin)
        return False

    def _read_json(self) -> dict | None:
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        if length < 0 or length > MAX_BODY:
            return None
        raw = self.rfile.read(length) if length else b"{}"
        try:
            payload = json.loads(raw)
        except (ValueError, UnicodeDecodeError):
            return None
        return payload if isinstance(payload, dict) else None

    # -- verbs -----------------------------------------------------------

    def do_OPTIONS(self) -> None:  # noqa: N802 (http.server API)
        origin = self.headers.get("Origin") or ""
        if origin and not origin_allowed(origin):
            self._send(403, {"error": "origin not allowed"})
            return
        self.send_response(204)
        if origin:
            self.send_header("Access-Control-Allow-Origin", origin)
            self.send_header("Vary", "Origin")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, X-Termchat-Token")
        self.send_header("Access-Control-Max-Age", "600")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self) -> None:  # noqa: N802
        origin = self._origin()
        if origin is None:
            return
        url = urlparse(self.path)
        if url.path == "/v1/ping":
            query = parse_qs(url.query)
            probe = (query.get("probe") or [""])[0]
            with self.bridge.cond:
                if probe != "client":
                    self.bridge.pings += 1
                    self.bridge.last_ping = time.monotonic()
                    self.bridge.cond.notify_all()
                age = (
                    None
                    if not self.bridge.last_ping
                    else round(time.monotonic() - self.bridge.last_ping, 1)
                )
                payload = {
                    "app": APP,
                    "version": VERSION,
                    "sites": list(SITES),
                    "mode": self.bridge.mode,
                    "polls": sorted(self.bridge.polls),
                    "pending": len(self.bridge.pending),
                    "active": len(self.bridge.active),
                    "last_ping_age": age,
                }
            self._send(200, payload, origin)
            return
        if not self._authorized(origin):
            return
        if url.path.startswith("/v1/state/"):
            job_id = url.path[len("/v1/state/") :].strip("/")
            query = parse_qs(url.query)
            try:
                after = int((query.get("after") or ["-1"])[0])
            except ValueError:
                after = -1
            try:
                wait_s = float((query.get("wait") or ["0"])[0])
            except ValueError:
                wait_s = 0.0
            snap = self.bridge.snapshot(job_id, after, min(max(wait_s, 0.0), 25.0))
            if snap is None:
                self._send(404, {"error": "unknown job"}, origin)
            else:
                self._send(200, snap, origin)
            return
        if url.path == "/v1/job":
            query = parse_qs(url.query)
            site = (query.get("site") or [""])[0]
            if site not in SITES:
                self._send(400, {"error": "unknown site"}, origin)
                return
            with self.bridge.cond:
                self.bridge.polls.add(site)
                self.bridge.cond.notify_all()
            try:
                wait = float((query.get("wait") or ["2"])[0])
            except ValueError:
                wait = 2.0
            job = self.bridge.take(site, min(max(wait, 0.0), 25.0))
            if job is None:
                self._send(204, None, origin)
                return
            self._send(
                200,
                {
                    "id": job.id,
                    "site": site,
                    "prompt": job.prompt,
                    "new_chat": job.new_chat,
                    "inspect": job.inspect,
                    "timeout_ms": int(job.timeout * 1000),
                    "version": VERSION,
                },
                origin,
            )
            return
        self._send(404, {"error": "not found"}, origin)

    def do_POST(self) -> None:  # noqa: N802
        origin = self._origin()
        if origin is None:
            return
        if not self._authorized(origin):
            return
        url = urlparse(self.path)
        parts = [part for part in url.path.split("/") if part]
        if url.path == "/v1/request":
            payload = self._read_json()
            if payload is None:
                self._send(400, {"error": "invalid JSON body"}, origin)
                return
            site = str(payload.get("site") or "")
            if site not in SITES:
                self._send(400, {"error": "unknown site"}, origin)
                return
            prompt = payload.get("prompt")
            if not isinstance(prompt, str):
                self._send(400, {"error": "prompt must be a string"}, origin)
                return
            try:
                job_timeout = float(payload.get("timeout") or DEFAULT_TIMEOUT)
            except (TypeError, ValueError):
                job_timeout = DEFAULT_TIMEOUT
            job = Job(
                site=site,
                prompt=prompt,
                new_chat=bool(payload.get("new_chat", True)),
                inspect=bool(payload.get("inspect", False)),
                timeout=max(1.0, job_timeout),
            )
            self.bridge.submit(job)
            self._send(200, {"id": job.id, "site": site}, origin)
            return
        if len(parts) == 4 and parts[0] == "v1" and parts[1] == "request" and parts[3] == "cancel":
            if not self.bridge.cancel(parts[2]):
                self._send(404, {"error": "unknown or finished job"}, origin)
                return
            self._send(200, {"ok": True}, origin)
            return
        if len(parts) == 4 and parts[0] == "v1" and parts[1] == "job" and parts[3] in (
            "progress",
            "done",
            "log",
        ):
            job_id, action = parts[2], parts[3]
            payload = self._read_json()
            if payload is None:
                self._send(400, {"error": "invalid JSON body"}, origin)
                return
            if action == "log":
                if self.bridge.verbose:
                    sys.stderr.write(
                        f"[page] {payload.get('level', 'info')}: {payload.get('message', '')}\n"
                    )
                self._send(200, {"ok": True}, origin)
                return
            if action == "progress":
                ok = self.bridge.update(job_id, text=str(payload.get("text", "")))
            else:
                markdown = payload.get("markdown")
                ok = self.bridge.update(
                    job_id,
                    text=str(payload.get("text", "")),
                    markdown=markdown if isinstance(markdown, str) else None,
                    error=payload.get("error") or None,
                    meta=payload.get("meta") or None,
                    state="done",
                )
            if not ok:
                self._send(404, {"error": "unknown or finished job"}, origin)
                return
            self._send(200, {"ok": True}, origin)
            return
        self._send(404, {"error": "not found"}, origin)


def start_bridge(
    bridge: Bridge, base_port: int, span: int, bind: str = "127.0.0.1"
) -> tuple[ThreadingHTTPServer, int]:
    for port in range(base_port, base_port + span):
        try:
            server = ThreadingHTTPServer((bind, port), BridgeHandler)
        except OSError:
            continue
        server.daemon_threads = True
        BridgeHandler.bridge = bridge
        threading.Thread(
            target=server.serve_forever, name="termchat-bridge", daemon=True
        ).start()
        return server, port
    raise SystemExit(
        f"termchat: could not bind {bind} port in {base_port}..{base_port + span - 1}"
    )


# --------------------------------------------------------------------------
# shared server / client
# --------------------------------------------------------------------------


class RemoteError(RuntimeError):
    pass


class RemoteClient:
    """Talks to a persistent `termchat serve` process."""

    def __init__(self, url: str, token: str = "") -> None:
        self.url = url.rstrip("/")
        self.token = token

    def _call(
        self,
        path: str,
        method: str = "GET",
        body: dict | None = None,
        timeout: float = 5.0,
    ) -> dict | None:
        data = None if body is None else json.dumps(body).encode("utf-8")
        request = urllib.request.Request(self.url + path, data=data, method=method)
        if data is not None:
            request.add_header("Content-Type", "application/json")
        if self.token:
            request.add_header("X-Termchat-Token", self.token)
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                raw = response.read()
        except urllib.error.HTTPError as exc:
            detail = ""
            try:
                payload = json.loads(exc.read() or b"{}")
                if isinstance(payload, dict):
                    detail = str(payload.get("error") or "")
            except (ValueError, OSError):
                pass
            raise RemoteError(detail or f"HTTP {exc.code}") from exc
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            raise RemoteError(f"cannot reach {self.url}: {exc}") from exc
        if not raw:
            return None
        try:
            payload = json.loads(raw)
        except ValueError as exc:
            raise RemoteError(f"invalid response from {self.url}") from exc
        return payload if isinstance(payload, dict) else None

    def ping(self) -> dict | None:
        return self._call("/v1/ping?probe=client", timeout=1.5)

    def submit(self, job: Job) -> str:
        payload = self._call(
            "/v1/request",
            "POST",
            {
                "site": job.site,
                "prompt": job.prompt,
                "new_chat": job.new_chat,
                "inspect": job.inspect,
                "timeout": job.timeout,
            },
            timeout=10.0,
        )
        if not payload or not payload.get("id"):
            raise RemoteError("server did not return a job id")
        return str(payload["id"])

    def state(self, job_id: str, after: int, wait: float = 2.0) -> dict:
        payload = self._call(
            f"/v1/state/{job_id}?after={after}&wait={wait:g}",
            timeout=wait + 5.0,
        )
        if not payload:
            raise RemoteError("server returned no job state")
        return payload

    def cancel(self, job_id: str) -> None:
        try:
            self._call(f"/v1/request/{job_id}/cancel", "POST", {}, timeout=3.0)
        except RemoteError:
            pass


def normalize_server_url(value: str, default_port: int) -> str:
    if "://" not in value:
        value = "http://" + value
    parsed = urlparse(value)
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or default_port
    hostpart = f"[{host}]" if ":" in host else host
    return f"http://{hostpart}:{port}"


def detect_server(base_port: int) -> str | None:
    """Return the local persistent server's URL, ignoring ephemeral bridges."""
    url = f"http://127.0.0.1:{base_port}"
    try:
        payload = RemoteClient(url).ping()
    except RemoteError:
        return None
    if payload and payload.get("app") == APP and payload.get("mode") == "server":
        return url
    return None


def check_remote(remote: RemoteClient, site: str, wait: float, verbose: bool = False) -> int:
    deadline = time.monotonic() + max(0.0, wait)
    last_error = ""
    last_age: float | None = None
    while True:
        try:
            info = remote.ping()
        except RemoteError as exc:
            last_error = str(exc)
            info = None
        if info:
            polls = info.get("polls") or []
            age = info.get("last_ping_age")
            if isinstance(age, (int, float)):
                last_age = float(age)
            if verbose:
                print(
                    f"termchat: server {remote.url}: pending={info.get('pending', 0)} "
                    f"active={info.get('active', 0)} polls={','.join(polls) or '-'} "
                    f"last_ping={'-' if age is None else f'{age}s ago'}",
                    file=sys.stderr,
                )
            if site in polls:
                print(
                    f"termchat: the extension is polling for {site}. "
                    "The server is reachable.",
                    file=sys.stderr,
                )
                return 0
            last_error = ""
        if time.monotonic() >= deadline:
            break
        time.sleep(0.25)

    if last_error:
        print(f"termchat: {last_error}", file=sys.stderr)
        print(
            "termchat: is 'termchat serve' running and reachable from this machine?",
            file=sys.stderr,
        )
    elif last_age is not None and last_age < 15:
        print(
            f"termchat: the extension is reaching the server, but no chat tab is "
            f"polling for {site}. Reload the {site} tab.",
            file=sys.stderr,
        )
    else:
        print(
            "termchat: nothing reached the server recently. If the browser runs on "
            "another machine, set the extension Options Host to this machine (not "
            "127.0.0.1), allow the permission, then reload the chat tab.",
            file=sys.stderr,
        )
    return 1


# --------------------------------------------------------------------------
# prompt gathering
# --------------------------------------------------------------------------


def read_file(path: str, read_stdin) -> tuple[str, str]:
    if path == "-":
        return "<stdin>", read_stdin()
    file_path = Path(path)
    data = file_path.read_bytes()
    if b"\x00" in data[:8192]:
        raise OSError(f"{path}: looks like a binary file")
    return str(file_path), data.decode("utf-8", errors="replace")


def compose_prompt(parts: list[str], files: list[tuple[str, str]]) -> str:
    prompt = " ".join(part for part in parts if part).strip()
    if not files:
        return prompt
    blocks: list[str] = []
    for name, data in files:
        if not data.endswith("\n"):
            data += "\n"
        blocks.append(f'<file path="{name}">\n{data}</file>')
    if prompt:
        blocks.append(prompt)
    return "\n\n".join(blocks)


def gather_prompt(args: argparse.Namespace) -> str:
    stdin_used = False

    def read_stdin() -> str:
        nonlocal stdin_used
        if stdin_used:
            return ""
        stdin_used = True
        return sys.stdin.read()

    files: list[tuple[str, str]] = []
    for path in args.file:
        files.append(read_file(path, read_stdin))

    parts = list(args.prompt)
    if parts == ["-"]:
        parts = [read_stdin()]
    elif (
        not parts
        and not args.interactive
        and not args.inspect
        and not stdin_used
        and not sys.stdin.isatty()
    ):
        parts = [read_stdin()]

    return compose_prompt(parts, files)


# --------------------------------------------------------------------------
# output
# --------------------------------------------------------------------------


RESET = "\x1b[0m"


def _style(text: str, *codes: str, color: bool) -> str:
    if not color or not text:
        return text
    return "".join(codes) + text + RESET


def render_inline(text: str, color: bool) -> str:
    """Apply inline Markdown styling, leaving the words themselves alone."""
    stash: list[str] = []

    def hold(value: str) -> str:
        stash.append(value)
        return f"\x00{len(stash) - 1}\x00"

    def inline_code(match: re.Match[str]) -> str:
        value = " ".join(match.group(2).split())
        return hold(_style(value, "\x1b[36m", color=color))

    def link(match: re.Match[str]) -> str:
        label, url = match.group(1), match.group(2)
        if not url.startswith(("http://", "https://", "mailto:")):
            return hold(label)
        if url == label:
            return hold(_style(label, "\x1b[4m", color=color))
        shown = _style(url, "\x1b[2;4m", color=color)
        return hold(f"{label} ({shown})")

    work = re.sub(r"(`+)(.+?)\1", inline_code, text)
    work = re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)", link, work)
    work = re.sub(
        r"\*\*\*(.+?)\*\*\*",
        lambda m: _style(m.group(1), "\x1b[1m", "\x1b[3m", color=color),
        work,
    )
    work = re.sub(
        r"\*\*(.+?)\*\*",
        lambda m: _style(m.group(1), "\x1b[1m", color=color),
        work,
    )
    work = re.sub(
        r"(?<![\w_])__(.+?)__(?![\w_])",
        lambda m: _style(m.group(1), "\x1b[1m", color=color),
        work,
    )
    work = re.sub(
        r"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)",
        lambda m: _style(m.group(1), "\x1b[3m", color=color),
        work,
    )
    work = re.sub(
        r"(?<![\w_])_(?!_)(.+?)(?<!_)_(?![\w_])",
        lambda m: _style(m.group(1), "\x1b[3m", color=color),
        work,
    )
    work = re.sub(
        r"~~(.+?)~~",
        lambda m: _style(m.group(1), "\x1b[9m", color=color),
        work,
    )
    if stash:
        work = re.sub(r"\x00(\d+)\x00", lambda m: stash[int(m.group(1))], work)
    return work


def render_markdown(markdown: str, color: bool = True, width: int = 0) -> str:
    """Render Markdown for a terminal without reflowing it.

    Text and code keep their line breaks; styling is added around them. Code
    blocks keep their exact contents (only indented), so columns and layout
    survive.
    """
    if not width:
        width = min(shutil.get_terminal_size((80, 24)).columns, 72)
    lines = markdown.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    out: list[str] = []
    fence: list[str] | None = None

    def flush_fence() -> None:
        nonlocal fence
        if fence is None:
            return
        for code_line in fence:
            out.append("  " + _style(code_line, "\x1b[36m", color=color))
        fence = None

    for raw in lines:
        opener = re.match(r"^\s*```(.*)$", raw)
        if opener:
            if fence is None:
                fence = []
            else:
                flush_fence()
            continue
        if fence is not None:
            fence.append(raw)
            continue

        line = raw.rstrip()
        if not line.strip():
            if out and out[-1] != "":
                out.append("")
            continue

        heading = re.match(r"^(#{1,6})\s+(.*)$", line)
        if heading:
            level = len(heading.group(1))
            text = render_inline(heading.group(2), color)
            if level == 1:
                out.append(_style(text, "\x1b[1m", "\x1b[4m", "\x1b[36m", color=color))
            elif level == 2:
                out.append(_style(text, "\x1b[1m", "\x1b[36m", color=color))
            elif level == 3:
                out.append(_style(text, "\x1b[1m", "\x1b[34m", color=color))
            else:
                out.append(_style(text, "\x1b[1m", color=color))
            continue

        if re.match(r"^\s*([-*_])(\s*\1){2,}\s*$", line):
            out.append(_style("─" * width, "\x1b[2m", color=color))
            continue

        quote = re.match(r"^\s*>\s?(.*)$", line)
        if quote:
            out.append(
                _style("│ ", "\x1b[2m", color=color)
                + render_inline(quote.group(1), color)
            )
            continue

        item = re.match(r"^(\s*)([-*+]|\d+[.)])\s+(.*)$", line)
        if item:
            indent, marker, body = item.groups()
            task = re.match(r"\[([ xX])\]\s+(.*)", body)
            if task:
                box = "☑" if task.group(1).lower() == "x" else "☐"
                marker_text = _style(box, "\x1b[33m", color=color)
                body = task.group(2)
            elif marker in "-*+":
                marker_text = _style("•", "\x1b[33m", color=color)
            else:
                marker_text = _style(marker, "\x1b[33m", color=color)
            out.append(f"{indent}{marker_text} {render_inline(body, color)}")
            continue

        if line.lstrip().startswith("|") and re.match(r"^\s*\|[\s:|-]+\|\s*$", line):
            out.append(_style(line, "\x1b[2m", color=color))
            continue

        out.append(render_inline(line, color))

    flush_fence()
    while out and not out[-1]:
        out.pop()
    return "\n".join(out)


def print_delta(text: str, printed: str, stream: bool) -> str:
    if not stream or not text:
        return printed
    if text.startswith(printed):
        if len(text) > len(printed):
            sys.stdout.write(text[len(printed) :])
            sys.stdout.flush()
        return text
    # The page rewrote earlier text; wait for the final version.
    return printed


def emit_final(text: str, printed: str, stream: bool) -> None:
    if not stream:
        sys.stdout.write(text)
        if not text.endswith("\n"):
            sys.stdout.write("\n")
        sys.stdout.flush()
        return
    if text.startswith(printed):
        rest = text[len(printed) :]
    else:
        rest = text
        if printed and not printed.endswith("\n"):
            sys.stdout.write("\n")
    if rest:
        sys.stdout.write(rest)
    if not text.endswith("\n"):
        sys.stdout.write("\n")
    sys.stdout.flush()


def emit_answer(
    text: str,
    markdown: str | None,
    printed: str,
    *,
    stream: bool,
    styled: bool,
    color: bool,
) -> None:
    if not styled:
        emit_final(text, printed, stream)
        return
    body = (markdown or "").strip() or text
    rendered = render_markdown(body, color=color)
    if rendered:
        sys.stdout.write(rendered)
        if not rendered.endswith("\n"):
            sys.stdout.write("\n")
    sys.stdout.flush()


def save_diagnostics(job: Job) -> Path | None:
    if not job.meta:
        return None
    try:
        base = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
        folder = base / "terminal-chat"
        folder.mkdir(parents=True, exist_ok=True)
        path = folder / f"job-{time.strftime('%Y%m%d-%H%M%S')}-{job.id[:8]}.json"
        payload = {"site": job.site, "error": job.error, **job.meta}
        path.write_text(json.dumps(payload, indent=2, ensure_ascii=False), encoding="utf-8")
        return path
    except OSError:
        return None


# --------------------------------------------------------------------------
# running a job
# --------------------------------------------------------------------------


def wait_for_extension(bridge: Bridge, job: Job, timeout: float, site: str) -> bool:
    start = time.monotonic()
    warned = False
    while True:
        with bridge.cond:
            if job.assigned:
                return True
        elapsed = time.monotonic() - start
        if elapsed >= timeout:
            return False
        if bridge.verbose and not warned and elapsed > 2.0:
            print(
                f"termchat: waiting for the browser extension for {site}",
                file=sys.stderr,
            )
            warned = True
        time.sleep(0.1)


def check_bridge(bridge: Bridge, bind: str, port: int, wait: float, site: str) -> int:
    """Report how far the extension gets: reach the bridge, then poll a job."""
    where = f"port {port}" if bind in ("0.0.0.0", "::") else f"{bind}:{port}"
    print(
        f"termchat: listening on {where}; waiting up to {wait:g}s for the extension",
        file=sys.stderr,
    )
    deadline = time.monotonic() + wait
    saw_ping = False
    while True:
        with bridge.cond:
            polls = set(bridge.polls)
            pings = bridge.pings
        if polls:
            print(
                "termchat: the extension is polling for "
                f"{', '.join(sorted(polls))}. The bridge is reachable.",
                file=sys.stderr,
            )
            return 0
        if pings and not saw_ping:
            saw_ping = True
            print(
                "termchat: the extension reached the bridge; waiting for a chat tab "
                f"on {SITE_ORIGINS.get(site, site)}.",
                file=sys.stderr,
            )
        if time.monotonic() >= deadline:
            break
        with bridge.cond:
            bridge.cond.wait(0.25)

    if saw_ping:
        print(
            "termchat: the extension reached the bridge but never asked for a job. "
            "Reload the chat tab.",
            file=sys.stderr,
        )
        return 1
    print(
        "termchat: nothing reached the bridge. In the extension Options, set Host "
        "to this machine, allow the permission, and check the network path.",
        file=sys.stderr,
    )
    return 1


def run_job(
    bridge: Bridge,
    job: Job,
    *,
    timeout: float,
    wait: float,
    stream: bool,
    json_mode: bool,
    bridge_hint: str = "",
    styled: bool = False,
    color: bool = True,
) -> int:
    bridge.submit(job)
    if not wait_for_extension(bridge, job, wait, job.site):
        where = f" (bridge on {bridge_hint})" if bridge_hint else ""
        print(f"termchat: no browser tab picked up the job{where}.", file=sys.stderr)
        print(
            f"termchat: run 'termchat {job.site} --check' to see whether the "
            "extension can reach this bridge.",
            file=sys.stderr,
        )
        return 3

    deadline = time.monotonic() + timeout + 30
    printed = ""
    state = job.state
    text = job.text
    markdown = job.markdown
    error = job.error
    meta = job.meta

    while True:
        with bridge.cond:
            state, text, error, meta = job.state, job.text, job.error, job.meta
            markdown = job.markdown
        if state == "done":
            break
        if time.monotonic() > deadline:
            error = f"timed out after {timeout:g}s waiting for the page"
            break
        if stream and text != printed:
            printed = print_delta(text, printed, stream)
        with bridge.cond:
            bridge.cond.wait(0.2)

    if job.inspect:
        print(json.dumps(meta or {}, indent=2, ensure_ascii=False))
        return 0 if state == "done" and not error else 1

    if error:
        if stream and printed:
            sys.stdout.write("\n")
        print(f"termchat: {error}", file=sys.stderr)
        path = save_diagnostics(job)
        if path is not None:
            print(f"termchat: page diagnostics saved to {path}", file=sys.stderr)
        if json_mode:
            print(
                json.dumps(
                    {"site": job.site, "text": text or "", "error": error, "meta": meta},
                    ensure_ascii=False,
                )
            )
        return 1

    final = text or ""
    if json_mode:
        print(
            json.dumps(
                {"site": job.site, "text": final, "error": None, "meta": meta},
                ensure_ascii=False,
            )
        )
    else:
        emit_answer(
            final,
            markdown,
            printed,
            stream=stream,
            styled=styled,
            color=color,
        )
    return 0


def run_remote(
    remote: RemoteClient,
    job: Job,
    *,
    timeout: float,
    wait: float,
    stream: bool,
    json_mode: bool,
    styled: bool = False,
    color: bool = True,
) -> int:
    try:
        job_id = remote.submit(job)
    except RemoteError as exc:
        print(f"termchat: {exc}", file=sys.stderr)
        return 3

    start = time.monotonic()
    deadline = start + timeout + 30
    idle_since = start
    after = -1
    printed = ""
    picked = False
    state = "pending"
    text = ""
    markdown: str | None = None
    error: str | None = None
    meta: dict | None = None

    try:
        while True:
            try:
                snap = remote.state(job_id, after, 2.0)
            except RemoteError as exc:
                if "unknown job" in str(exc):
                    print(
                        "termchat: the server no longer has this job "
                        "(its client stopped polling).",
                        file=sys.stderr,
                    )
                else:
                    print(f"termchat: {exc}", file=sys.stderr)
                return 1
            after = int(snap.get("seq", after))
            state = str(snap.get("state") or state)
            text = str(snap.get("text") or "")
            if isinstance(snap.get("markdown"), str):
                markdown = snap["markdown"]
            error = snap.get("error") or None
            meta = snap.get("meta") or None
            if state in ("running", "done"):
                picked = True

            queued = int(snap.get("queued_ahead") or 0)
            if queued:
                # Someone else's job is ahead of us; the connect timeout
                # should not start until our turn.
                idle_since = time.monotonic()

            if not picked and time.monotonic() - idle_since > wait:
                if queued == 0:
                    remote.cancel(job_id)
                    print(
                        f"termchat: no browser tab picked up the job (server {remote.url}).",
                        file=sys.stderr,
                    )
                    print(
                        f"termchat: run 'termchat {job.site} --check' to see whether the "
                        "extension can reach this server.",
                        file=sys.stderr,
                    )
                    return 3

            if stream and text != printed:
                printed = print_delta(text, printed, stream)
            if state == "done":
                break
            if time.monotonic() > deadline:
                remote.cancel(job_id)
                error = f"timed out after {timeout:g}s waiting for the page"
                break
    except KeyboardInterrupt:
        remote.cancel(job_id)
        raise

    if snap.get("inspect"):
        print(json.dumps(meta or {}, indent=2, ensure_ascii=False))
        return 0 if state == "done" and not error else 1

    if error:
        if stream and printed:
            sys.stdout.write("\n")
        print(f"termchat: {error}", file=sys.stderr)
        if meta:
            failed = Job(
                site=job.site,
                prompt="",
                new_chat=False,
                inspect=False,
                timeout=0,
                error=error,
                meta=meta,
                state="done",
            )
            path = save_diagnostics(failed)
            if path is not None:
                print(f"termchat: page diagnostics saved to {path}", file=sys.stderr)
        if json_mode:
            print(
                json.dumps(
                    {"site": job.site, "text": text or "", "error": error, "meta": meta},
                    ensure_ascii=False,
                )
            )
        return 1

    final = text or ""
    if json_mode:
        print(
            json.dumps(
                {"site": job.site, "text": final, "error": None, "meta": meta},
                ensure_ascii=False,
            )
        )
    else:
        emit_answer(
            final,
            markdown,
            printed,
            stream=stream,
            styled=styled,
            color=color,
        )
    return 0


def interactive(
    bridge: Bridge | None,
    args: argparse.Namespace,
    *,
    timeout: float,
    wait: float,
    stream: bool,
    bridge_hint: str = "",
    remote: RemoteClient | None = None,
    styled: bool = False,
    color: bool = True,
) -> int:
    site = args.site
    new_chat = not args.continue_chat
    print(
        f"termchat {site}: type a message (:help for commands, :quit to exit)",
        file=sys.stderr,
    )
    while True:
        try:
            line = input(f"{site}> ")
        except (EOFError, KeyboardInterrupt):
            print(file=sys.stderr)
            return 0
        if line.endswith("\\"):
            chunks = [line[:-1]]
            while True:
                try:
                    more = input("...> ")
                except (EOFError, KeyboardInterrupt):
                    print(file=sys.stderr)
                    return 0
                if more.endswith("\\"):
                    chunks.append(more[:-1])
                else:
                    chunks.append(more)
                    break
            line = "\n".join(chunks)

        command = line.strip()
        if not command:
            continue
        if command in (":quit", ":q", ":exit"):
            return 0
        if command == ":help":
            print(
                "  :new       start the next message in a new chat\n"
                "  :continue  keep using the open chat\n"
                "  :inspect   dump what the extension can see on the page\n"
                "  :quit      exit",
                file=sys.stderr,
            )
            continue
        if command == ":new":
            new_chat = True
            print("termchat: next message starts a new chat", file=sys.stderr)
            continue
        if command in (":continue", ":cont"):
            new_chat = False
            print("termchat: next message continues the open chat", file=sys.stderr)
            continue
        if command == ":inspect":
            job = Job(site=site, prompt="", new_chat=False, inspect=True, timeout=timeout)
            if remote is not None:
                run_remote(remote, job, timeout=timeout, wait=wait, stream=False, json_mode=True)
            else:
                run_job(
                    bridge,
                    job,
                    timeout=timeout,
                    wait=wait,
                    stream=False,
                    json_mode=True,
                    bridge_hint=bridge_hint,
                )
            continue

        job = Job(site=site, prompt=line, new_chat=new_chat, inspect=False, timeout=timeout)
        new_chat = False
        if remote is not None:
            run_remote(
                remote,
                job,
                timeout=timeout,
                wait=wait,
                stream=stream,
                json_mode=args.json,
                styled=styled,
                color=color,
            )
        else:
            run_job(
                bridge,
                job,
                timeout=timeout,
                wait=wait,
                stream=stream,
                json_mode=args.json,
                bridge_hint=bridge_hint,
                styled=styled,
                color=color,
            )


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------


def config_path() -> Path:
    base = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    return base / "terminal-chat" / "config.json"


def load_config() -> dict:
    try:
        data = json.loads(config_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def as_float(value: object, default: float) -> float:
    try:
        return float(value)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return float(default)


def as_int(value: object, default: int) -> int:
    try:
        return int(value)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return int(default)


def serve_main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="termchat serve",
        description=(
            "Run one persistent bridge that the browser extension and any number "
            "of termchat clients can share."
        ),
    )
    parser.add_argument(
        "--bind",
        default=None,
        metavar="ADDR",
        help="address to listen on (default 127.0.0.1; 0.0.0.0 for remote clients)",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=None,
        help=f"port to listen on (default {DEFAULT_BASE_PORT})",
    )
    parser.add_argument(
        "--token",
        default=None,
        metavar="TOKEN",
        help="require this token from extensions and clients",
    )
    parser.add_argument("-v", "--verbose", action="store_true", help="log bridge traffic")
    args = parser.parse_args(argv)

    config = load_config()
    port = args.port or as_int(
        os.environ.get("TERMCHAT_BASE_PORT") or config.get("base_port"), DEFAULT_BASE_PORT
    )
    bind = (
        args.bind
        or os.environ.get("TERMCHAT_BIND")
        or str(config.get("bind") or "127.0.0.1")
    )
    token = (
        args.token
        if args.token is not None
        else os.environ.get("TERMCHAT_TOKEN") or str(config.get("token") or "")
    )
    pending_ttl = as_float(
        os.environ.get("TERMCHAT_PENDING_TTL") or config.get("pending_ttl"), 15.0
    )

    bridge = Bridge(
        verbose=args.verbose,
        token=token,
        mode="server",
        pending_ttl=max(1.0, pending_ttl),
    )
    BridgeHandler.bridge = bridge
    try:
        server = ThreadingHTTPServer((bind, port), BridgeHandler)
    except OSError as exc:
        print(f"termchat: cannot listen on {bind}:{port}: {exc}", file=sys.stderr)
        print("termchat: is another server already using that port?", file=sys.stderr)
        return 1
    server.daemon_threads = True
    print(f"termchat: server listening on http://{bind}:{port}", file=sys.stderr)
    if not is_loopback_address(bind) and not token:
        print(
            f"termchat: no token; anyone who can reach http://{bind}:{port} "
            "can submit jobs",
            file=sys.stderr,
        )
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print(file=sys.stderr)
    finally:
        server.server_close()
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="termchat",
        description=(
            "Talk to Gemini, Copilot or DeepSeek chat from the terminal through "
            "your logged-in browser."
        ),
        epilog=(
            "examples:\n"
            "  termchat gemini 'Explain io_uring in two paragraphs'\n"
            "  termchat copilot -f src/main.go 'Review this Go file'\n"
            "  cat notes.md | termchat deepseek 'Summarise this'\n"
            "  termchat gemini --continue 'And what about the error path?'\n"
            "  termchat deepseek --inspect\n"
            "  termchat serve --bind 0.0.0.0\n"
            "  termchat gemini 'hi' --server 10.0.0.5:8765\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("site", choices=SITES)
    parser.add_argument(
        "prompt",
        nargs="*",
        help="prompt text; use '-' or pipe stdin to read it",
    )
    parser.add_argument(
        "-f",
        "--file",
        action="append",
        default=[],
        metavar="PATH",
        help="include a file's contents in the prompt (repeatable, '-' for stdin)",
    )
    parser.add_argument(
        "--new",
        action="store_true",
        help="start a new chat (the default for a one-shot command)",
    )
    parser.add_argument(
        "--continue",
        dest="continue_chat",
        action="store_true",
        help="use the chat already open in the tab",
    )
    parser.add_argument(
        "--inspect",
        action="store_true",
        help="print what the extension sees on the page (for repairing selectors)",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="wait for the extension, report how far it gets, then exit",
    )
    parser.add_argument(
        "-i",
        "--interactive",
        action="store_true",
        help="read prompts in a small REPL",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=None,
        help=f"seconds to wait for an answer (default {DEFAULT_TIMEOUT:g})",
    )
    parser.add_argument(
        "--wait",
        type=float,
        default=None,
        help=f"seconds to wait for the browser extension (default {DEFAULT_CONNECT_WAIT:g})",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="print a JSON object instead of the answer text",
    )
    parser.add_argument(
        "--plain",
        action="store_true",
        help="print the answer as plain text, without Markdown styling",
    )
    parser.add_argument(
        "--markdown",
        action="store_true",
        help="render Markdown styling even when stdout is not a terminal",
    )
    parser.add_argument(
        "--server",
        default=None,
        metavar="URL",
        help=(
            "submit to a running 'termchat serve' (host[:port] or http://host:port); "
            "default: auto-detect a local server"
        ),
    )
    parser.add_argument(
        "--local",
        action="store_true",
        help="always start a private bridge, ignoring any running server",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=None,
        help=f"base port (default {DEFAULT_BASE_PORT})",
    )
    parser.add_argument(
        "--bind",
        default=None,
        metavar="ADDR",
        help="address to listen on (default 127.0.0.1; e.g. 0.0.0.0 for a remote browser)",
    )
    parser.add_argument(
        "--token",
        default=None,
        metavar="TOKEN",
        help="require this token from the extension (optional)",
    )
    parser.add_argument("-v", "--verbose", action="store_true", help="log bridge traffic")
    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "serve":
        return serve_main(argv[1:])

    parser = build_parser()
    args = parser.parse_args(argv)

    if args.new and args.continue_chat:
        parser.error("--new and --continue are mutually exclusive")
    if args.local and args.server:
        parser.error("--server and --local are mutually exclusive")
    if args.plain and args.markdown:
        parser.error("--plain and --markdown are mutually exclusive")

    config = load_config()
    base_port = args.port or as_int(
        os.environ.get("TERMCHAT_BASE_PORT") or config.get("base_port"), DEFAULT_BASE_PORT
    )
    span = max(1, as_int(config.get("port_span"), DEFAULT_PORT_SPAN))
    timeout = (
        args.timeout
        if args.timeout is not None
        else as_float(config.get("timeout"), DEFAULT_TIMEOUT)
    )
    wait = (
        args.wait
        if args.wait is not None
        else as_float(config.get("connect_wait"), DEFAULT_CONNECT_WAIT)
    )
    bind = (
        args.bind
        or os.environ.get("TERMCHAT_BIND")
        or str(config.get("bind") or "127.0.0.1")
    )
    token = (
        args.token
        if args.token is not None
        else os.environ.get("TERMCHAT_TOKEN") or str(config.get("token") or "")
    )

    remote: RemoteClient | None = None
    if not args.local:
        configured_server = (
            args.server
            or os.environ.get("TERMCHAT_SERVER")
            or str(config.get("server") or "")
        )
        if configured_server:
            remote = RemoteClient(
                normalize_server_url(configured_server, base_port), token
            )
        else:
            detected = detect_server(base_port)
            if detected is not None:
                remote = RemoteClient(detected, token)
                if args.verbose:
                    print(f"termchat: using server {detected}", file=sys.stderr)

    if args.check:
        prompt = ""
    else:
        try:
            prompt = gather_prompt(args)
        except OSError as exc:
            print(f"termchat: {exc}", file=sys.stderr)
            return 3

    if not args.interactive and not args.inspect and not args.check and not prompt.strip():
        parser.print_usage(sys.stderr)
        print(
            "termchat: give a prompt, pipe one in, or use -i/--inspect",
            file=sys.stderr,
        )
        return 3

    if len(prompt) > LARGE_PROMPT:
        print(
            f"termchat: prompt is large ({len(prompt):,} characters); "
            "the site may truncate it",
            file=sys.stderr,
        )

    styled = (
        not args.json
        and not args.inspect
        and not args.plain
        and (args.markdown or sys.stdout.isatty())
    )
    color = styled and "NO_COLOR" not in os.environ
    stream = not args.json and not styled and sys.stdout.isatty()

    if remote is not None:
        if args.check:
            return check_remote(remote, args.site, wait, args.verbose)
        if args.interactive:
            return interactive(
                None,
                args,
                timeout=timeout,
                wait=wait,
                stream=stream,
                remote=remote,
                styled=styled,
                color=color,
            )
        job = Job(
            site=args.site,
            prompt=prompt,
            new_chat=not args.continue_chat,
            inspect=args.inspect,
            timeout=timeout,
        )
        return run_remote(
            remote,
            job,
            timeout=timeout,
            wait=wait,
            stream=stream,
            json_mode=args.json,
            styled=styled,
            color=color,
        )

    bridge = Bridge(verbose=args.verbose, token=token)
    server, port = start_bridge(bridge, base_port, span, bind)
    if args.verbose:
        print(f"termchat: bridge listening on http://{bind}:{port}", file=sys.stderr)
        if not is_loopback_address(bind) and not token:
            print(
                f"termchat: no token; anyone who can reach "
                f"http://{bind}:{port} can use the bridge",
                file=sys.stderr,
            )
    bridge_hint = f"port {port}" if bind in ("0.0.0.0", "::") else f"{bind}:{port}"

    try:
        if args.check:
            return check_bridge(bridge, bind, port, wait, args.site)
        if args.interactive:
            return interactive(
                bridge,
                args,
                timeout=timeout,
                wait=wait,
                stream=stream,
                bridge_hint=bridge_hint,
                styled=styled,
                color=color,
            )
        job = Job(
            site=args.site,
            prompt=prompt,
            new_chat=not args.continue_chat,
            inspect=args.inspect,
            timeout=timeout,
        )
        return run_job(
            bridge,
            job,
            timeout=timeout,
            wait=wait,
            stream=stream,
            json_mode=args.json,
            bridge_hint=bridge_hint,
            styled=styled,
            color=color,
        )
    finally:
        server.shutdown()
        server.server_close()


if __name__ == "__main__":
    raise SystemExit(main())
